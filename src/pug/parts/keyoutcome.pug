section.keyoutcome
    .oranament-line
        .line.oranament-bg-up
            .line-square-right
            .line-square-left
    .container.keyoutcome__container
        .keyoutcome__content
            .keyoutcome__content-head
                .keyoutcome__content--icon
                    span(data-aos="fade-up" data-aos-delay="250" data-aos-offset="20").keyoutcome__content--span
                        img(src="/assets/images/icon_span.svg", alt="About Us Icon") 
                        span KEY OUTCOMES
                    img(src="/assets/images/icon_rightbtm.svg", alt="icon About Us Icon")
                h2(data-aos="fade-up" data-aos-delay="350" data-aos-offset="20").keyoutcome__content--title Key Outcomes That Drive Better Decisions.
                span.keyoutcome__content--span
                    span(data-aos="fade-up" data-aos-delay="450" data-aos-offset="20").keyoutcome__dsc Relianta brings all your financial and data tools together to simplify workflows and accelerate decisions.
            .keyoutcome__content-body
                .keyoutcome__content-body--title
                    span NO.
                    span SERVICES NAME
                    span DESCRIPTION
                .keyoutcome__content-body--list.key-1
                    .keyoutcome__content-body--item
                        span.item__number /01
                        span.item__title One Integration, Many Connections
                        .item__dsc 
                            span Consolidate gateways, identity providers, and backoffice tools behind a single API.
                            a.btn.btn-green <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 18 18" fill="none">
                                <path d="M12.8572 5.14289L5.14289 12.8572" stroke="white" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M12.8572 12.761V5.14313H5.23932" stroke="white" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                .keyoutcome__content-body--list.key-2
                    .keyoutcome__content-body--item
                        span.item__number /02
                        span.item__title Operational Clarity
                        .item__dsc 
                            span End to end visibility: what happened, why it happened, and what happens next.
                            a.btn.btn-green <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 18 18" fill="none">
                                <path d="M12.8572 5.14289L5.14289 12.8572" stroke="white" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M12.8572 12.761V5.14313H5.23932" stroke="white" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
